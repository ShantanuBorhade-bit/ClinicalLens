# ClinicalLens environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env

# --- Gemini -------------------------------------------------------------
# Get your API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to use (always-current alias; survives model retirements)
GEMINI_MODEL=gemini-flash-lite-latest
# Backup models tried automatically when the primary hits its daily quota
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest

# Low temperature keeps answers grounded and factual
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_SECONDS=60

# Retry with exponential backoff for transient errors (504/503/429/timeout)
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY=2.0

# --- Retrieval ----------------------------------------------------------
# How many chunks to retrieve per query (across ALL documents)
TOP_K=4

# --- Storage paths ------------------------------------------------------
# Relative paths are resolved against the project root; absolute paths work too
UPLOAD_FOLDER=uploads
CHROMA_DB_PATH=chroma_db

# --- API server ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend -----------------------------------------------------------
# URL the Streamlit UI uses to reach the FastAPI backend
BACKEND_URL=http://127.0.0.1:8000

# --- Upload limits ------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
